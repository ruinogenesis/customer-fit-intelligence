rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // A guest of the dashboard (T411) signs in anonymously, where the
    // project allows it (the Anonymous provider in Firebase Auth), and
    // reads what every role reads: no more, whatever else its token says.
    function isGuest() {
      return request.auth != null
        && request.auth.token.get('firebase', {}).get('sign_in_provider', '') == 'anonymous';
    }

    // Staff carry a role claim, set by python -m cfi_api.roles (T303):
    // viewer < analyst < admin. An account without one, such as a customer
    // of the ordering app, may read nothing here; a guest's counts for nothing.
    function isStaff() {
      return request.auth != null
        && !isGuest()
        && request.auth.token.role in ['admin', 'analyst', 'viewer'];
    }

    function isAdmin() {
      return isStaff() && request.auth.token.role == 'admin';
    }

    function isReader() {
      return isStaff() || isGuest();
    }

    // Who may read what (T304). Every role reads what the dashboard shows;
    // the roles differ in what they may do, which goes through the API
    // (cfi_api.access). No app writes anything: the API, Cloud Functions
    // and the training pipeline write through server SDKs, which these
    // rules don't affect. api/tests/test_firestore_rules.py checks every
    // collection against every kind of caller.

    match /customers/{customerId} {
      allow read: if isReader();

      match /scores/{eventId} {
        allow read: if isReader();
      }
    }

    match /orders/{orderId} {
      allow read: if isReader();
    }

    // Events as received, for an admin looking into a problem.
    match /events/{eventId} {
      allow read: if isAdmin();
    }

    // Staff read their own document; admins read everyone's.
    match /users/{uid} {
      allow get: if isStaff() && request.auth.uid == uid;
      allow read: if isAdmin();
    }

    // Everything else stays locked. Staff read the rules and the models
    // through the API (GET /rules, T406; GET /models, T310); for actions,
    // the task that first writes them decides who may read them.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
