# T306: kit instance "customers", streaming customers to BigQuery (bigquery/src/index.ts).
# Settings only, never secrets. Every setting the kit has is here, so a
# deploy never stops to ask; api/tests/test_bigquery_export.py checks that.
COLLECTION_PATH=customers
TABLE_ID=customers
WILDCARD_IDS=false
DATASET_ID=raw
DATASET_LOCATION=asia-southeast3
BIGQUERY_PROJECT_ID=cfi-dev-th26
DATABASE=(default)
# Blank on purpose: the functions run in the region index.ts sets.
DATABASE_REGION=
BACKUP_COLLECTION=bigquery_failures
MAX_DISPATCHES_PER_SECOND=100
MAX_ENQUEUE_ATTEMPTS=3
TRANSFORM_FUNCTION=
TABLE_PARTITIONING=NONE
TIME_PARTITIONING_FIELD=
TIME_PARTITIONING_FIELD_TYPE=omit
TIME_PARTITIONING_FIRESTORE_FIELD=
CLUSTERING=
USE_NEW_SNAPSHOT_QUERY_SYNTAX=no
EXCLUDE_OLD_DATA=no
VIEW_TYPE=view
MAX_STALENESS=
REFRESH_INTERVAL_MINUTES=
KMS_KEY_NAME=
LOG_LEVEL=info
